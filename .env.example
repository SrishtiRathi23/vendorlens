# VendorLens server configuration. Copy to .env.local for development; never commit real values.

# Gemini features are opt-in. With AI off, manual quote entry, comparison and samples still work.
AI_ENABLED=false

# vertex  = Gemini on Vertex AI via Application Default Credentials (no key; the default)
# developer = Gemini Developer API; GEMINI_API_KEY comes from Secret Manager in production
# fixture = recorded responses for automated tests; refused when NODE_ENV=production
AI_PROVIDER=vertex
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional second model, tried once if the first is unavailable or out of quota.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=

# Extra origins (comma-separated) allowed to call /api/ai/*. Same-origin requests are always allowed.
ALLOWED_ORIGINS=
